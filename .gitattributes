# Byte-exact synthetic math fixtures: preserve LF across Windows/Linux.
# Their SHA-256 and deterministic generator compare raw bytes, not text semantics.
curriculum/train.jsonl text eol=lf
curriculum/holdout.jsonl text eol=lf
curriculum/manifest.json text eol=lf
# Markdown and workflow edits must not cause whole-file CRLF churn.
README.md text eol=lf
.github/workflows/ci.yml text eol=lf
# Hard-math source index is a canonical one-line JSON record with final LF.
research/hard_problems/catalog.v1.json text eol=lf
research/hard_problems/synthetic-submissions.v1.json text eol=lf
# The proving54 manifest SHA-256 is bound into every session and hour receipt;
# a CRLF checkout on Windows would change it.
proving54/manifest.json text eol=lf
# The operator runner is hashed and run by Windows PowerShell 5.1; keep its bytes stable.
proving54/operator/tick54.ps1 text eol=lf
